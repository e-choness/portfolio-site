---
# Liquid so the name comes from _data/profile.yml and paths follow baseurl.
---
{
  "name": {{ "EchoOS — " | append: site.data.profile.name | jsonify }},
  "short_name": "EchoOS",
  "description": {{ site.data.profile.name | append: "'s portfolio as an interactive desktop" | jsonify }},
  "start_url": {{ "/" | relative_url | jsonify }},
  "scope": {{ "/" | relative_url | jsonify }},
  "display": "standalone",
  "background_color": "#e8e4ef",
  "theme_color": "#6a5ad6",
  "icons": [
    {
      "src": {{ "/assets/images/icons/app-192.png" | relative_url | jsonify }},
      "sizes": "192x192",
      "type": "image/png"
    },
    {
      "src": {{ "/assets/images/icons/app-512.png" | relative_url | jsonify }},
      "sizes": "512x512",
      "type": "image/png"
    },
    {
      "src": {{ "/assets/images/icons/app-maskable-512.png" | relative_url | jsonify }},
      "sizes": "512x512",
      "type": "image/png",
      "purpose": "maskable"
    },
    {
      "src": {{ "/assets/favicon.ico" | relative_url | jsonify }},
      "sizes": "16x16 32x32 48x48",
      "type": "image/x-icon"
    }
  ]
}
